# Copy to project root on the server, then edit secrets:
#   cp deployment/new-matcher/deploy.env.example deploy.env

PROJECT_ROOT=/var/www/new-matcher.bya3online.com
APP_DOMAIN=new-matcher.bya3online.com
API_DOMAIN=new-matcher-api.bya3online.com
NEXT_PUBLIC_API_URL=https://new-matcher-api.bya3online.com
FRONTEND_PORT=3005
PM2_APP_NAME=new-matcher-frontend
SYSTEMD_SERVICE=fastapi-new-matcher

# Required in production — must be identical for backend AND frontend (JWT cookie verification).
# Backend: systemd EnvironmentFile. Frontend: redeploy.sh / bootstrap.sh pass this to PM2.
JWT_SECRET=replace-with-long-random-string
